# ===== 참돔 트레이드 친구용 설정 =====
# 1) 이 파일 이름을 bot_config.env 로 바꾸세요 (.example 지우기)
# 2) 아래 '여기에_…' 부분을 본인 값으로 바꾸고 저장하세요
# 3) 이 파일은 절대 다른 사람에게 보내거나 인터넷에 올리지 마세요 (본인 업비트 키가 들어 있음)

# 업비트 Open API 키 — 이 PC의 IP를 등록해서 본인이 직접 발급 (자산조회·주문조회·주문하기만, 출금 금지)
UPBIT_ACCESS_KEY=여기에_Access_Key
UPBIT_SECRET_KEY=여기에_Secret_Key

# 대시보드(https://btypenine.github.io/chamdom/)에 본인 구글 계정으로 로그인
# → 맨 아래 'PC 봇 연결 코드' → 연결 코드 보기 → 코드 복사 → 한 줄로 붙여넣기
FIREBASE_LINK_CODE=여기에_연결_코드

# 친구용 표시 (바꾸지 마세요): 검증된 안정판만 자동 업데이트로 받음
ROLE=friend
UPDATE_CHANNEL=stable

# paper = 모의매매(실제 주문 없음), live = 실제 주문
# 처음 2~3일은 paper 로 돌려 보고, 대시보드로 동작을 확인한 뒤 live 로 바꾸길 권함
TRADE_MODE=paper

# 봇이 쓸 수 있는 최대 원화 (콤마 없이). 업비트에 이 금액 이상 원화가 있어야 함
BOT_BUDGET_KRW=100000

# 하루(오전 9시 기준) 손실이 이 금액에 닿으면 다음 날 9시까지 새 매수 중지
DAILY_LOSS_LIMIT=30000

# 절대 사고팔지 않을 코인 (쉼표로 구분, 예: BTC,ETH). 이미 들고 있는 코인을 지키고 싶을 때. 비워 두면 없음
PROTECTED_COINS=

# 대시보드에 표시될 이 PC 이름
DEVICE_NAME=내 PC
