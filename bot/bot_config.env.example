# 이 파일 이름을 bot_config.env 로 바꾸고 아래 값을 채우세요.
# 이 파일은 절대 다른 사람에게 보내거나 GitHub에 올리지 마세요.

# 업비트 Open API 키 (이 PC의 IP로 발급받은 키)
UPBIT_ACCESS_KEY=여기에_Access_Key
UPBIT_SECRET_KEY=여기에_Secret_Key

# 웹페이지 > PC 봇 연결 코드 > 연결 코드 보기 > 코드 복사 후 붙여넣기 (한 줄로)
FIREBASE_LINK_CODE=여기에_연결_코드

# live = 실제 주문, paper = 모의매매 (이 줄이 없으면 모의매매)
TRADE_MODE=live

# 시작 시드 (봇이 쓸 수 있는 최대 원화, 콤마 없이)
BOT_BUDGET_KRW=200000

# 1회 기본 매수 금액
ORDER_KRW=10000

# 마틴게일: 손실 후 다음 주문을 2배로 (0=끔, 3이면 1만→2만→4만→8만까지)
MARTINGALE_MAX_LEVEL=3

# 하루(09시 기준) 손실이 이 금액에 닿으면 다음 날 9시까지 신규 매수 중지 (0=제한 없음)
DAILY_LOSS_LIMIT=100000

# 웹페이지에 표시될 이 PC 이름
DEVICE_NAME=회사 게임PC

# (선택) AI 분석가: Anthropic 콘솔에서 발급한 API 키. 넣으면 손실 5건마다·매일 9시에 거래를 분석해 수정안을 폰에 보여줌
ANTHROPIC_API_KEY=여기에_Anthropic_API_키
